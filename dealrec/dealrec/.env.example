# Shared defaults. Copy this file to .env, then create the matching mode file:
#   .env.development  from .env.development.example
#   .env.production   from .env.production.example
# Variables already set in the process environment take precedence.

# Public origin used in invitation, verification and QR links
APP_URL="http://localhost:3000"

# Long random value used to sign session cookies (32+ characters)
SESSION_SECRET="replace-with-a-long-random-secret"

# Private document storage directory (relative to the app directory)
STORAGE_DIR=".storage"

# Optional email delivery (Resend). Without these, emails are logged in development.
RESEND_API_KEY=""
EMAIL_FROM="dealrec <records@your-domain.example>"

# Optional SMS delivery (Termii). Without these, SMS messages are logged in development.
SMS_API_KEY=""
SMS_SENDER_ID=""

# Protects GET /api/cron/reminders. Send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
