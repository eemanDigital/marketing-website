# Set these in the Vercel project dashboard or another host, not in git.
# Copy to .env.production only for local production checks.
DATABASE_URL="postgresql://USER:PASSWORD@ep-prod-xxx-pooler.REGION.aws.neon.tech/dealrec?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-prod-xxx.REGION.aws.neon.tech/dealrec?sslmode=require"
APP_URL="https://your-domain.example"
SESSION_SECRET="replace-with-a-long-random-secret"

# Vercel has no persistent writable disk. Cloudflare R2 is used for production.
# Create an R2 API token with Object Read & Write access for this bucket.
# The code still uses the S3-compatible API; S3_* aliases are also supported.
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_REGION="auto"
R2_FORCE_PATH_STYLE="false"
STORAGE_DIR=".storage"

# Resend email. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="dealrec <records@your-verified-domain.example>"

# Optional SMS via Termii.
SMS_API_KEY=""
SMS_SENDER_ID=""

# Protects GET /api/cron/reminders.
CRON_SECRET=""
